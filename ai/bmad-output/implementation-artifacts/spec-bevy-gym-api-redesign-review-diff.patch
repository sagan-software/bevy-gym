+        self.state = [
+            TAU.mul_add(x_dot, x),
+            TAU.mul_add(x_acc, x_dot),
+            TAU.mul_add(theta_dot, theta),
+            TAU.mul_add(theta_acc, theta_dot),
+        ];
+        self.steps += 1;
+
+        let [x, _, theta, _] = self.state;
+        let status = if !(-X_THRESHOLD..=X_THRESHOLD).contains(&x)
